{
  "name": "scumble-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo build",
    "bump": "node scripts/bump-version.mjs",
    "dev": "turbo dev --filter=scumble-example",
    "dev:website": "pnpm --filter @scumble/website dev",
    "example:ios": "pnpm --filter scumble-example ios",
    "example:android": "pnpm --filter scumble-example android",
    "test": "turbo test",
    "codegen": "pnpm --filter @scumble/native codegen",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md}\" && node scripts/format-native.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md}\" && node scripts/format-native.mjs --check"
  },
  "devDependencies": {
    "clang-format": "^1.8.0",
    "prettier": "^3.3.0",
    "turbo": "^2.5.3",
    "typescript": "~5.9.3"
  }
}
