---
# C++ / Objective-C(++) formatting. Applied by `pnpm format` via the
# clang-format npm package. Based on LLVM (2-space, attached braces), which
# matches the existing ScumbleRenderer.cc / iOS .m/.mm style.
BasedOnStyle: LLVM
IndentWidth: 2
TabWidth: 2
UseTab: Never
ColumnLimit: 100

# Keep short lambdas/closures on one line (used in ScumbleCanvasShadowNode.mm
# flatbuffers serialization, ScumblePropParser flush blocks).
AllowShortLambdasOnASingleLine: All
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortBlocksOnASingleLine: Empty

# ObjC: align colons in method declarations / calls.
ObjCBinPackProtocolList: Never
ObjCSpaceAfterProperty: false
ObjCSpaceBeforeProtocolList: true
