{
  "name": "@lynx-skity/native",
  "version": "0.0.1",
  "description": "A native Lynx library",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./elements": "./src/elements.ts"
  },
  "files": [
    "src",
    "types",
    "generated",
    "scripts",
    "harmony",
    "lynx.lib.json",
    "lynx-skity.podspec",
    "README.md",
    "android/src/main/java",
    "android/src/main/cpp",
    "android/src/main/fbs-gen",
    "android/src/main/AndroidManifest.xml",
    "android/CMakeLists.txt",
    "android/build.gradle.kts",
    "ios/Classes",
    "shared/skity/SkityRenderer.cc",
    "shared/skity/SkityRenderer.h",
    "shared/skity/generated",
    "shared/nativeModule",
    "shared/elements",
    "shared/CMakeLists.txt",
    "shared/third_party/flatbuffers/include",
    "shared/third_party/flatbuffers/LICENSE",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "lynx-autolink-codegen",
    "generate-fbs": "node scripts/generate-fbs.mjs",
    "postinstall": "node scripts/generate-fbs.mjs"
  },
  "dependencies": {
    "@lynx-js/weak-node-api": "^0.0.9",
    "@lynx-js/lynx-library-headers": "*"
  },
  "devDependencies": {
    "@lynx-js/autolink-codegen": "^0.4.0",
    "@lynx-js/types": "3.9.0"
  }
}
