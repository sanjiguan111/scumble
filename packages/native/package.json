{
  "name": "@scumble/native",
  "version": "0.1.0",
  "description": "A native Lynx library",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./elements": "./src/elements.ts"
  },
  "files": [
    "src",
    "types",
    "generated",
    "scripts",
    "harmony",
    "lynx.lib.json",
    "scumble.podspec",
    "README.md",
    "android/src/main/java",
    "android/src/main/cpp",
    "android/src/main/fbs-gen",
    "android/src/main/AndroidManifest.xml",
    "android/CMakeLists.txt",
    "android/build.gradle.kts",
    "ios/Classes",
    "ios/addon_use.h",
    "ios/generated",
    "shared/skity",
    "shared/nativeModule",
    "shared/elements",
    "shared/CMakeLists.txt",
    "shared/third_party/flatbuffers/include",
    "shared/third_party/flatbuffers/LICENSE",
    "shared/third_party/sheenbidi/Headers",
    "shared/third_party/sheenbidi/Source",
    "shared/third_party/sheenbidi/LICENSE",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "lynx-autolink-codegen",
    "generate-fbs": "node scripts/generate-fbs.mjs",
    "test:native": "node scripts/run-native-tests.mjs",
    "prepublishOnly": "node scripts/generate-fbs.mjs"
  },
  "dependencies": {
    "@lynx-js/weak-node-api": "^0.0.9",
    "@lynx-js/lynx-library-headers": "*"
  },
  "devDependencies": {
    "@lynx-js/autolink-codegen": "^0.4.0",
    "@lynx-js/types": "3.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuiwenTang/scumble.git",
    "directory": "packages/native"
  },
  "homepage": "https://ruiwentang.github.io/scumble",
  "bugs": {
    "url": "https://github.com/RuiwenTang/scumble/issues"
  }
}
