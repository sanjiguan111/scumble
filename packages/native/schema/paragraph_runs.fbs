// Paragraph transport — the side channel next to CommandBatch.
//
// Design (TEXT_PARAGRAPH_DESIGN.md): text layout runs on the TASM thread
// inside measure, so this file carries data in BOTH directions:
//   - SpanList: the layout INPUT, JS-built (nested FlatBuffer bytes, base64
//     through the string prop channel like the gradients) — text + span
//     styles only, NEVER glyph data.
//   - ParagraphRunList: the layout OUTPUT, platform-built on the TASM thread
//     and delivered to the render thread through the extra bundle alongside
//     the command batch (same flush, atomically aligned). Glyph runs keyed by
//     node id; the renderer stores them on the retained node and draws each
//     run with one DrawGlyphs call.
//
// Fonts cross the thread boundary through the shared FontRegistry (TASM
// creates the skity::Font — the REAL typeface after platform fallback — and
// registers it; runs reference it by id; the render thread looks it up).

namespace skityrt;

// Text decoration stroke style, shared by the Span input (what JS asks for)
// and the TextDecorationRun output (what the layout backend laid out). Value
// order follows RN-Skia's TextDecorationStyle (numeric passthrough) — fixed
// once shipped, append only.
enum DecorationStyle : byte {
  SOLID = 0,
  DOUBLE = 1,
  DOTTED = 2,
  DASHED = 3,
  WAVY = 4,
}

// ---- Layout input (JS → TASM) ----

// One styled run of source text. Font resolution happens natively: fontFamily
// goes through FontManager::MatchFamilyStyle (system fonts) or the custom-font
// registry (data URI key); missing glyphs fall back via
// MatchFamilyStyleCharacter on the platform side.
table Span {
  text:string;
  fontFamily:string;        // empty = default
  fontSize:float = 14;      // px
  fontWeight:int = 400;     // 100–900
  italic:bool = false;
  color:uint = 0xFF000000;  // 0xAARRGGBB
  letterSpacing:float = 0;  // px, applied by the layout layer (skity has none)
  // Text decoration (RN-Skia TextStyle parity). `decoration` is a bitfield:
  // 1 = UNDERLINE, 2 = OVERLINE, 4 = LINE_THROUGH (combinable; 0 = none).
  // decorationColor 0 = follow the text color (0 doubles as "unset" — an
  // explicit fully-transparent black falls back too). decorationThickness is
  // ABSOLUTE px, 0 = the font's metric thickness (a deliberate deviation from
  // RN-Skia's multiplier semantics). decorationStyle applies to every set bit.
  // Appended so existing field ids stay stable.
  decoration:uint = 0;
  decorationColor:uint = 0;
  decorationThickness:float = 0;
  decorationStyle:DecorationStyle = SOLID;
}
table SpanList {
  spans:[Span];
}

// ---- Layout output (TASM → render thread) ----

// One DrawGlyphs call: same typeface + size + color. Positions are relative to
// the paragraph box origin (the node's x/y geometry applies on top).
table ParagraphGlyphRun {
  glyphs:[ushort];          // skity GlyphID (== CGGlyph on iOS)
  pos_x:[float];
  pos_y:[float];
  font_id:uint;             // FontRegistry key (the post-fallback font)
  color:uint;               // 0xAARRGGBB (span color)
}
// One decoration line over one span's slice of one line. The geometry is a
// LAYOUT product (computed on the TASM thread): the wire glyph runs carry no
// advances and iOS pos_y mixes per-glyph offsets, so the renderer could not
// reconstruct x/y even in principle (TEXT_PARAGRAPH_DESIGN.md §7). x/width/y
// are in paragraph-box space (same space as ParagraphGlyphRun pos_x/pos_y);
// y is the CENTER of the line (SkParagraph's draw_line_as_rect is symmetric
// around it). color is RESOLVED (decorationColor, else the span color — never
// 0 here). One entry per (span × line × decoration bit); thickness is already
// resolved from metrics when the Span left it unset.
table TextDecorationRun {
  x:float;                  // left edge of the decorated visual interval
  width:float;              // (max glyph pen + advance) − (min glyph pen)
  y:float;                  // line center, y-down, absolute in the paragraph box
  thickness:float;          // resolved stroke thickness (px)
  color:uint;               // 0xAARRGGBB
  style:DecorationStyle = SOLID;
}
table ParagraphLayout {
  node_id:int = -1;
  height:float;             // laid-out content height (px)
  line_count:int;
  runs:[ParagraphGlyphRun];
  decorations:[TextDecorationRun]; // appended (field ids stay stable)
}
table ParagraphRunList {
  entries:[ParagraphLayout];
}
