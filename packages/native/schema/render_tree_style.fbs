// render_tree_style.fbs
// Path commands, transform operations, and computed styles for skity.
// Derived from lynx-native-svg's schema (Apache-2.0), trimmed to the MVP
// (no font/text/filter/mask/clip-path fields).

include "render_tree_common.fbs";

namespace skityrt;

// ---- Path commands (normalized to absolute coordinates) ----

enum PathCommandType : byte {
  MOVE_TO  = 0,  // args: x, y
  LINE_TO  = 1,  // args: x, y
  CUBIC_TO = 2,  // args: x1, y1, x2, y2, x, y
  QUAD_TO  = 3,  // args: x1, y1, x, y
  ARC_TO   = 4,  // args: rx, ry, rotation, largeArcFlag, sweepFlag, x, y
  CLOSE    = 5,  // args: (none)
}

table PathCommand {
  type:PathCommandType = MOVE_TO;
  args:[float];
}

// ---- Transform operations (pre-parsed) ----

enum TransformType : byte {
  MATRIX    = 0,  // args: a, b, c, d, tx, ty
  TRANSLATE = 1,  // args: tx [, ty]
  SCALE     = 2,  // args: sx [, sy]
  ROTATE    = 3,  // args: angle [, cx, cy]
  SKEW_X    = 4,  // args: angle
  SKEW_Y    = 5,  // args: angle
}

table TransformOp {
  type:TransformType = MATRIX;
  args:[float];
}

// ---- Computed style ----

table ComputedStyle {
  // Painting
  fill:ResolvedPaint;
  stroke:ResolvedPaint;
  stroke_width:float = 1.0;
  stroke_linecap:LineCap = BUTT;
  stroke_linejoin:LineJoin = MITER;
  stroke_dasharray:[float];
  stroke_dashoffset:float = 0.0;
  stroke_miterlimit:float = 4.0;
  fill_rule:FillRule = NONZERO;

  // Opacity & visibility
  opacity:float = 1.0;
  display:Display = INLINE;
  visibility:Visibility = VISIBLE;

  // Transform (pre-parsed operations) — legacy vector, superseded by
  // transform_data (kept during the migration; removed once native consumes
  // the nested flatbuffer path).
  transform:[TransformOp];
  // JS-built TransformOpList bytes, memcpy'd verbatim by native measure
  // (nested flatbuffer). The native side never parses the transform string.
  transform_data:[ubyte] (nested_flatbuffer: "TransformOpList");
}

// ---- Nested-flatbuffer wrappers (JS-built, memcpy'd by native) ----
// Each is a standalone root-able FlatBuffer built on the JS side with
// flatbuffers.js, carried as a [ubyte] blob, and read back on the render side
// via the nested_flatbuffer accessor. See RENDER_ARCHITECTURE.md §5.

table PathCommandList {
  commands:[PathCommand];
}

table TransformOpList {
  ops:[TransformOp];
}

// ---- Group clip (JS-built ClipList, memcpy'd by native) ----
// A group may carry a sequence of clip shapes applied in order before its
// subtree is drawn (the canvas accumulates intersect/difference ops natively).

enum ClipOp : uint {
  INTERSECT  = 0,
  DIFFERENCE = 1,
}

enum ClipType : uint {
  RECT  = 0, // x, y, width, height
  RRECT = 1, // + rx, ry
  PATH  = 2, // nested PathCommandList bytes
}

table Clip {
  type:ClipType = RECT;
  op:ClipOp = INTERSECT;
  x:float = 0;
  y:float = 0;
  width:float = 0;
  height:float = 0;
  rx:float = 0;
  ry:float = 0;
  path:[ubyte] (nested_flatbuffer: "PathCommandList");
}

table ClipList {
  clips:[Clip];
}

// ---- Path boolean ops (JS-built PathOpList, evaluated at render time) ----
// skity has no synchronous call back to JS (the Lynx public SDK disables NAPI
// on Android), so a boolean composition travels as a description and the
// renderer evaluates it per frame via skity PathOp::Execute.

enum PathOpKind : byte {
  DIFFERENCE = 0, // value order == skity::PathOp::Op (== Skia SkPathOp)
  INTERSECT  = 1,
  UNION      = 2,
  XOR        = 3,
}

// One operand of the left-fold chain. A leaf carries the operand's geometry as
// nested PathCommandList bytes; a right-nested composition (e.g. (A-B)∪(C-D))
// carries the sub-tree as nested PathOpList bytes instead — mutually exclusive.
table PathOperand {
  // How this operand folds into the running result (skity PathOp::Execute).
  // Ignored for the first operand (it is the base).
  op:PathOpKind = UNION;
  commands:[ubyte] (nested_flatbuffer: "PathCommandList");
  nested:[ubyte] (nested_flatbuffer: "PathOpList");
}

// Left-fold: operands[0] is the base, each following operand combines into the
// accumulated result with its own op. Evaluated at render time in DrawShape
// (before trim/fillRule, which apply to the boolean result).
table PathOpList {
  operands:[PathOperand];
}

// ---- Paint filters (JS-built Filter, applied at render time) ----
// One filter description per paint slot (color/image/mask — see
// SetPaintFilter). skity builds the filter and the HW canvas applies it as a
// filter pass (hw_filters.cc ConvertPaintToHWFilter chains mask → image →
// color). Only the kinds the HW backend implements are modeled — no
// morphology (Dilate/Erode are absent from the hw switch).

enum FilterKind : byte {
  IMAGE_BLUR = 0,        // fx = sigma_x, fy = sigma_y
  IMAGE_DROP_SHADOW = 1, // fx = dx, fy = dy, fz = sigma, color
  IMAGE_COMPOSE = 2,     // children applied in declaration order ([0] innermost)
  COLOR_MATRIX = 3,      // matrix (20 row-major, Skia layout)
  COLOR_BLEND = 4,       // color + mode
  MASK_BLUR = 5,         // fx = radius, style
}

// skity::BlurStyle starts at 1 (kNormal..kInner) — NOT Skia's 0-based order.
enum BlurStyle : byte {
  NORMAL = 1,
  SOLID  = 2,
  OUTER  = 3,
  INNER  = 4,
}

table Filter {
  kind:FilterKind = IMAGE_BLUR;
  fx:float = 0;
  fy:float = 0;
  fz:float = 0;
  color:uint = 0; // IMAGE_DROP_SHADOW / COLOR_BLEND (0xAARRGGBB)
  mode:uint = 0;  // COLOR_BLEND: skityrt::BlendMode byte (== skity order)
  style:BlurStyle = NORMAL; // MASK_BLUR
  matrix:[float]; // COLOR_MATRIX: 20 row-major
  children:[Filter]; // IMAGE_COMPOSE (may nest further composes)
}
