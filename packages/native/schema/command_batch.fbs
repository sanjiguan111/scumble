// command_batch.fbs
// Phase 2 incremental command stream. Step 1b carries paint/path/transform;
// Step 2 adds structural Insert/Remove/Move; Step 3a adds geometry/viewport.
// The snapshot channel still coexists as a full-tree fallback until Step 3b
// retires it (see RENDER_ARCHITECTURE.md §11.10).
//
// The retained render tree on the render thread applies each CommandBatch
// after syncing from the latest snapshot.

include "render_tree_common.fbs"; // LineCap, LineJoin, FillRule
include "render_tree_style.fbs";  // PathCommandList, TransformOpList

namespace skityrt;

// How a bitmap is inscribed into the destination rect (the CSS object-fit
// family, extended). Value order follows the canonical BoxFit so the
// renderer's applyBoxFit port stays 1:1 comparable. (Declared up front:
// SetPaint references it for the image-shader slots.)
enum BoxFit : byte {
  FILL      = 0,
  CONTAIN   = 1,
  COVER     = 2,
  FIT_WIDTH = 3,
  FIT_HEIGHT= 4,
  NONE      = 5,
  SCALE_DOWN= 6,
}

// Shader tiling (image shaders). Value order matches skity's TileMode exactly
// so the renderer casts the byte straight through (same convention as
// BlendMode). (Declared up front: SetPaint references it.)
enum TileMode : byte {
  CLAMP  = 0,
  REPEAT = 1,
  MIRROR = 2,
  DECAL  = 3,
}

// Bit flags identifying which SetPaint fields are intentionally set in this
// command. FlatBuffer defaults make "field == 0" ambiguous (0 is a valid
// color / cap / ...), so the producer sets the bit for every field it wants the
// consumer to apply; the consumer ignores fields whose bits are 0.
enum PaintField : uint {
  NONE         = 0,
  FILL         = 1,
  STROKE       = 2,
  STROKE_WIDTH = 4,
  STROKE_CAP   = 8,
  STROKE_JOIN  = 16,
  STROKE_MITER = 32,
  FILL_RULE    = 64,
  OPACITY      = 128,
  FILL_GRADIENT   = 256, // fill_gradient bytes (nested Gradient FlatBuffer)
  STROKE_GRADIENT = 512, // stroke_gradient bytes (nested Gradient FlatBuffer)
  STROKE_DASH     = 1024, // stroke_dash intervals + stroke_dashoffset (empty vector = no dash)
  BLEND_MODE      = 2048, // blend_mode (applies to both the fill and stroke paints)
  FILL_IMAGE_SHADER   = 4096, // fill_image_* fields (image shader; empty uri clears)
  STROKE_IMAGE_SHADER = 8192, // stroke_image_* fields
}

// One logical mutation. Step 1b: paint/path/transform. Step 2: structural.
// Step 3a: geometry/viewport. While the snapshot channel still coexists, the
// geometry/viewport commands land as same-value no-ops under the Apply→Sync
// ordering; they become load-bearing once Step 3b retires the snapshot.
union Command {
  SetPaint,     // paint fields, gated by fields_dirty
  SetPathData,  // PathCommandList bytes (memcpy from the JS-built blob)
  SetTransform, // TransformOpList bytes (memcpy from the JS-built blob)
  InsertNode,   // Step 2: create a node under parent_id at index; parent_id==-1 => root (canvas)
  RemoveNode,   // Step 2: destroy a node + its subtree
  MoveNode,     // Step 2: reparent / reorder; subtree follows
  SetGeometry,  // Step 3a: per-field geometry, gated by fields_dirty
  SetViewport,  // Step 3a: canvas logical viewport (viewBox)
  SetClip,      // group clip: ClipList bytes (memcpy from the JS-built blob)
  SetPathOpData,// path boolean ops: PathOpList bytes, evaluated at render time
  SetPaintFilter,// one paint-filter slot: nested Filter bytes (fill/stroke × color/image/mask)
  SetImageSource,// image node: source uri + fit (pixels arrive via the platform image loader)
  SetAnimation, // native animation tracks: nested AnimationList bytes (render-thread interpolation)
}

// Paint mutation. fill_color / stroke_color are 0xAARRGGBB; the paint is
// implicitly COLOR when the FILL/STROKE bit is set, or GRADIENT when the
// FILL_GRADIENT/STROKE_GRADIENT bit is set (the *_gradient bytes are a nested
// Gradient FlatBuffer built on the JS side, memcpy'd verbatim like SetPathData).
// "Inactive paint" (null fillColor) is encoded by NOT setting any of these bits.
table SetPaint {
  node_id:int = -1;
  fields_dirty:PaintField = NONE;
  fill_color:uint = 0; // valid only if FILL bit set
  stroke_color:uint = 0; // valid only if STROKE bit set
  fill_gradient:[ubyte] (nested_flatbuffer: "Gradient"); // valid only if FILL_GRADIENT bit set
  stroke_gradient:[ubyte] (nested_flatbuffer: "Gradient"); // valid only if STROKE_GRADIENT bit set
  stroke_width:float = 1.0;
  stroke_cap:LineCap = BUTT;
  stroke_join:LineJoin = MITER;
  stroke_miter:float = 4.0;
  fill_rule:FillRule = NONZERO;
  opacity:float = 1.0;
  // Stroke dash pattern (valid only if STROKE_DASH bit set): on/off intervals in
  // px — [on, off, on, off, ...], even count, sum > 0 — plus the phase offset
  // into the pattern. An empty/absent vector clears dashes. Appended so
  // existing field ids stay stable.
  stroke_dash:[float];
  stroke_dashoffset:float = 0.0;
  // Blend mode for the node's paints (inheritable; applied to both fill and
  // stroke). Appended so existing field ids stay stable.
  blend_mode:BlendMode = SRC_OVER;
  // Image shader (image as fill/stroke texture), the declarative-shader
  // sibling of the gradients. Valid only if the FILL_IMAGE_SHADER /
  // STROKE_IMAGE_SHADER bit is set; an empty/absent uri clears the slot. The
  // pixels themselves never ride this command — the uri is the ImageStore key
  // AND the platform loader request (fired by the TASM setter, same as
  // SetImageSource), and the renderer skips the paint until they land.
  // rect is [x, y, w, h]; null/len<4 = identity (1:1 tiling at the bitmap's
  // intrinsic size). fit is resolved at render time against the intrinsic
  // size, same as SetImageSource.fit. Appended so existing field ids stay
  // stable.
  fill_image_uri:string;
  fill_image_fit:BoxFit = CONTAIN;
  fill_image_tx:TileMode = CLAMP;
  fill_image_ty:TileMode = CLAMP;
  fill_image_rect:[float];
  stroke_image_uri:string;
  stroke_image_fit:BoxFit = CONTAIN;
  stroke_image_tx:TileMode = CLAMP;
  stroke_image_ty:TileMode = CLAMP;
  stroke_image_rect:[float];
}

table SetPathData {
  node_id:int = -1;
  // JS-built PathCommandList bytes, memcpy'd verbatim by the TASM side.
  data:[ubyte] (nested_flatbuffer: "PathCommandList");
}

table SetTransform {
  node_id:int = -1;
  // JS-built TransformOpList bytes, memcpy'd verbatim by the TASM side.
  data:[ubyte] (nested_flatbuffer: "TransformOpList");
}

// Phase 2 Step 2: structural commands. Topology is driven by these (the
// retained tree is the source of truth); the snapshot only refreshes field
// values. A batch orders them Insert -> Move -> Remove (parents before children,
// the node exists when Move runs, removed last).
table InsertNode {
  node_id:int = -1;
  parent_id:int = -1; // -1 => root insert (canvas itself has no skity parent)
  index:uint = 0;     // position within parent.children
  tag_name:string;    // e.g. "rect", "g", "canvas"
}

table RemoveNode {
  node_id:int = -1;
}

table MoveNode {
  node_id:int = -1;
  new_parent_id:int = -1; // -1 => becomes root
  index:uint = 0;
}

// Bit flags identifying which SetGeometry fields are intentionally set. Same
// rationale as PaintField: 0 is a valid geometry value (e.g. radius 0), so the
// bitmask is authoritative — the consumer writes only fields whose bits are set.
enum GeometryField : uint {
  NONE       = 0,
  X          = 1,
  Y          = 2,
  WIDTH      = 4,
  HEIGHT     = 8,
  CX         = 16,
  CY         = 32,
  R          = 64,
  RX         = 128,
  RY         = 256,
  X1         = 512,
  Y1         = 1024,
  X2         = 2048,
  Y2         = 4096,
  PATH_START = 8192,
  PATH_END   = 16384,
  POINTS     = 32768,
}

// Per-field geometry mutation. Only fields whose GeometryField bit is set in
// fields_dirty are written; the rest are left untouched. Values are logical px
// in the canvas viewport coordinate space (same as RenderNode geometry).
table SetGeometry {
  node_id:int = -1;
  fields_dirty:GeometryField = NONE;
  x:float = 0;
  y:float = 0;
  width:float = 0;
  height:float = 0;
  cx:float = 0;
  cy:float = 0;
  r:float = 0;
  rx:float = 0;
  ry:float = 0;
  x1:float = 0;
  y1:float = 0;
  x2:float = 0;
  y2:float = 0;
  // Path trimming (normalized [0,1] length fraction; skity PathMeasure). Only
  // the first contour is trimmed (multi-contour TODO). Appended so existing
  // field ids stay stable.
  path_start:float = 0;
  path_end:float = 1;
  // Polyline/polygon vertices [x0,y0,x1,y1,...] (flat, logical px). Valid only
  // if the POINTS bit is set; at least 2 vertices (4 floats) draws. An
  // empty/absent vector clears the vertices. Appended so existing field ids
  // stay stable.
  points:[float];
}

// Canvas logical viewport (SVG viewBox). Targets the tree-level viewport (not a
// node field), so node_id is the canvas root id (kept for symmetry/logging;
// the consumer ignores it). width<=0 || height<=0 disables the viewport
// (logical px == physical px), mirroring the snapshot's UpdateViewportFromFB.
table SetViewport {
  node_id:int = -1;
  x:float = 0;
  y:float = 0;
  width:float = 0;
  height:float = 0;
}

// Group clip sequence (group nodes only). An empty/absent data vector clears
// the clip. Applied by the renderer after the node's transform, before its
// subtree — the clip geometry is in the group's local coordinate space.
table SetClip {
  node_id:int = -1;
  data:[ubyte] (nested_flatbuffer: "ClipList");
}

// Path boolean-op description (path nodes). The JS side never computes the
// boolean result (no synchronous channel back); the renderer evaluates the
// PathOpList per frame in BuildPath, before trim/fillRule. An empty/absent
// data vector clears the op payload — the node falls back to its plain
// path_data ("d").
table SetPathOpData {
  node_id:int = -1;
  data:[ubyte] (nested_flatbuffer: "PathOpList");
}

// Which paint of a node a filter attaches to.
enum PaintSlot : byte {
  FILL   = 0,
  STROKE = 1,
}

// Which filter slot on that paint (skity Paint has one of each).
enum FilterSlot : byte {
  COLOR = 0,
  IMAGE = 1,
  MASK  = 2,
}

// Set one paint-filter slot (fill/stroke × color/image/mask) on a node. The
// JS-built Filter bytes are memcpy'd and turned into skity filter objects at
// paint construction (MakeFillPaint/MakeStrokePaint). An empty/absent data
// vector clears the slot.
table SetPaintFilter {
  node_id:int = -1;
  slot:PaintSlot = FILL;
  kind:FilterSlot = COLOR;
  data:[ubyte] (nested_flatbuffer: "Filter");
}

// Image sampling (image nodes only). Value order matches skity's
// FilterMode/MipmapMode exactly so the renderer casts the byte straight
// through (same convention as BlendMode). cubic B/C both zero means cubic
// resampling is off (skity's convention); when cubic is on, filter is ignored.
enum ImageFilterMode : byte {
  NEAREST = 0,
  LINEAR  = 1,
}

enum ImageMipmapMode : byte {
  NONE    = 0,
  NEAREST = 1,
  LINEAR  = 2,
}

// Image node source (image nodes only). The uri is the ImageStore key AND the
// platform loader request (http(s) URL or data URI); the platform TASM setter
// fires the load when it first sees the uri, pixels land in the store from the
// render thread, and the renderer skips the node until they arrive. fit is
// resolved at render time against the bitmap's intrinsic size (the JS side
// never knows it). An empty/absent uri clears the source (node draws nothing).
// Destination rect (x/y/width/height) rides the regular SetGeometry channel.
table SetImageSource {
  node_id:int = -1;
  uri:string;
  fit:BoxFit = CONTAIN;
  // Sampling appended after fit so existing field ids stay stable. Defaults
  // reproduce the pre-sampling hardcoded behavior (linear filter, no mipmap,
  // no cubic resampler).
  filter_mode:ImageFilterMode = LINEAR;
  mipmap_mode:ImageMipmapMode = NONE;
  cubic_b:float = 0;
  cubic_c:float = 0;
}

// Node animation tracks (JS-built AnimationList bytes, memcpy'd like
// SetClip). The render thread parses the tracks once and interpolates them
// per vsync into a per-node overlay — the base fields are never touched
// (see ANIMATION_DESIGN.md). An empty/absent data vector clears ALL
// animations on the node.
table SetAnimation {
  node_id:int = -1;
  data:[ubyte] (nested_flatbuffer: "AnimationList");
}

table CommandBatch {
  // Monotonic per-canvas sequence number (debug only in Step 1b; Step 2 makes
  // it load-bearing for ordering once the snapshot channel is retired).
  version:uint = 0;
  commands:[Command];
}

root_type CommandBatch;
