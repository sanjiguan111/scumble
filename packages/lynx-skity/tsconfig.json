{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "rootDir": "."
  },
  "include": ["src", "types", "generated"]
}
