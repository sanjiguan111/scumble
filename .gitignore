# Dependencies
node_modules/

# Build outputs
dist/
**/build/
**/.turbo/
**/.vitepress/cache/

# CMake-generated third-party headers (shared/CMakeLists.txt copies them here)
**/shared/third_party/

# flatc-generated FlatBuffer stubs (regenerated by `pnpm --filter @scumble/native
# generate-fbs`, runs on postinstall; needs the habitat-fetched flatc).
**/shared/skity/generated/
**/android/src/main/fbs-gen/
# TypeScript FlatBuffer stubs + vendored flatbuffers runtime (@scumble/graphics).
packages/graphics/src/generated/

# Android / Gradle
**/.gradle/
**/.cxx/
local.properties
*.iml

# iOS / CocoaPods
**/Pods/
**/*.xcuserstate
**/*.xcworkspace/
xcuserdata/
# Lynx autolink (cocoapods-lynx-library) regenerates this on pod install.
**/generated/lynx-library/
# Note: Gemfile.lock and Podfile.lock ARE committed (pin versions).

# HarmonyOS
**/oh_modules/
*.hap
*.hsp

# TypeScript incremental build info
*.tsbuildinfo

# IDE (Android Studio / IntelliJ)
.idea/

# Misc
*.log
.DS_Store
packages/native/tests/compile_commands.json
packages/native/tests/.cache/
# lat.md tool-managed cache (search vector index + init state, rebuilt locally)
lat.md/.cache/
# Claude Code: local-only settings (skills/, agents/, settings.json are shared)
.claude/settings.local.json
.mcp.json
.codex
# ZCode: local-only session state (agent workspace/scratch files)
.zcode/
# victory-native: codemod-generated src/ (upstream comes from the npm
# package's bundled src/; the wrapper's committed surface is shims/, scripts/, configs)
packages/victory-native/src/

# ZCode: local-only session config
.zcodeignore

# One-shot npm bootstrap placeholders (publish → register trusted-publisher
# → delete; see packages README / release.yml header for the flow)
tmp/
